# Copy this file to .env.local and fill in the password.
# .env.local is gitignored — never commit real credentials.

# The mailbox that sends both the enquiry alert and the customer thank-you.
SMTP_EMAIL=info@studiomaterium.in

# Google Workspace rejects the normal account password. Generate a 16-character
# App Password instead (2-Step Verification must be on first):
#   myaccount.google.com/apppasswords
# Paste it with the spaces removed.
SMTP_PASSWORD=

# Where the enquiry alert lands. Falls back to SMTP_EMAIL if left blank.
RECIPIENT_EMAIL=info@studiomaterium.in

# Not needed — this mailbox is on Google Workspace, which the route handles by
# default. Only set these if the mailbox ever moves to another provider:
#   Zoho      smtp.zoho.in             / 465
#   Hostinger smtp.hostinger.com       / 465
#   GoDaddy   smtpout.secureserver.net / 465
# SMTP_HOST=
# SMTP_PORT=465
